{
  "name": "nidal-clubdeck-pro",
  "private": true,
  "version": "1.6.0",
  "description": "Portable professional multi-deck YouTube DJ mixer with projector visualizer.",
  "author": "Nidal-ClubDeck-pro",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.js",
    "build": "tsc -b && vite build",
    "desktop:dev": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --dir --win",
    "desktop:usb": "npm run build && electron-builder --win zip --x64",
    "desktop:portable": "npm run build && electron-builder --win portable --x64",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0",
    "tone": "^15.1.22",
    "wavesurfer.js": "^7.12.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.nidal.clubdeck.pro",
    "productName": "Nidal-ClubDeck-pro",
    "directories": {
      "output": "C:/tmp/clubdeck-pro-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "Nidal-ClubDeck-pro-USB-${version}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Nidal-ClubDeck-pro-Portable-${version}.${ext}"
    }
  }
}
